#!/usr/bin/env bash
# File generated by pre-commit: https://pre-commit.com

# start templated
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=commit-msg)
# end templated

HERE="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$HERE/.." && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

# Prefer the consumer project's own venv interpreter, matching the
# INSTALL_PYTHON shape pre-commit itself templates per-project.
INSTALL_PYTHON="$PROJECT_ROOT/env/Scripts/python.exe"
if [ ! -x "$INSTALL_PYTHON" ]; then
  INSTALL_PYTHON="$PROJECT_ROOT/env/bin/python"
fi

if [ -x "$INSTALL_PYTHON" ]; then
    exec "$INSTALL_PYTHON" -mpre_commit "${ARGS[@]}"
elif command -v pre-commit > /dev/null; then
    exec pre-commit "${ARGS[@]}"
else
    echo '`pre-commit` not found.  Did you forget to activate your virtualenv?' 1>&2
    exit 1
fi
